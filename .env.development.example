# Development environment.
# Used with Shopify CLI/dev stores and test billing.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_discounts,write_discounts,write_products,read_shipping,read_markets,write_metaobjects,write_metaobject_definitions
SESSION_STORAGE_BACKEND=file
SESSION_STORAGE_FILE=.data/shopify-sessions.json

SHOPIFY_BILLING_TEST=true

# Optional local override for faster UI testing.
# Remove this when testing real Shopify subscription state.
APP_PLAN_OVERRIDE=free

NODE_ENV=development
