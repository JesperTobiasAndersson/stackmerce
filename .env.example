# Shared environment variable reference.
# Copy the relevant environment file for local use. Never commit real secrets.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_discounts,write_discounts,write_products,read_shipping,read_markets,write_metaobjects,write_metaobject_definitions
SESSION_STORAGE_BACKEND=file
SESSION_STORAGE_FILE=.data/shopify-sessions.json
FIRESTORE_SESSION_COLLECTION=shopify_sessions

# Billing
# Development should use true. Production must use false for real charges.
SHOPIFY_BILLING_TEST=true

# Local-only plan override. Ignored when NODE_ENV=production.
# Allowed values: free, pro, enterprise.
APP_PLAN_OVERRIDE=

NODE_ENV=development
