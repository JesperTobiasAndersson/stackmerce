# Production environment.
# Values should be set in the hosting provider secret manager.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-production-domain.com
SCOPES=read_discounts,write_discounts,write_products,read_shipping,read_markets,write_metaobjects,write_metaobject_definitions
SESSION_STORAGE_BACKEND=firestore
FIRESTORE_SESSION_COLLECTION=shopify_sessions

# Must be false for real Shopify charges.
SHOPIFY_BILLING_TEST=false

# Do not set APP_PLAN_OVERRIDE in production.

NODE_ENV=production
