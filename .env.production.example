# Production environment (Cloud Run).
# Non-secret values are set in cloudbuild.yaml; secrets live in Secret Manager.
# DATABASE_URL is created automatically when you connect the Neon integration.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://discount-app-437971048935.europe-west3.run.app
SCOPES=read_discounts,write_discounts,read_shipping,read_markets
SESSION_STORAGE_BACKEND=neon
DATABASE_URL=
SESSION_STORAGE_TABLE=shopify_sessions

# Must be false for real Shopify charges.
SHOPIFY_BILLING_TEST=false

# Do not set APP_PLAN_OVERRIDE in production.

NODE_ENV=production
